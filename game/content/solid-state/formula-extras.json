    "source": [
     {
      "file": "materials/solid-state/scripts/Script-2026 2026-09-01.pdf",
      "where": "eqs. (3.59), (3.62)"
     }
    ],
    "blocks": [
     {
      "kind": "text",
      "html": "The tight-binding dispersion in the script&#8217;s notation, with nearest-neighbour hopping $t$ on a simple cubic lattice of constant $a$:"
     },
     {
      "kind": "eq",
      "tex": "\\varepsilon(\\mathbf k)=\\varepsilon-t_0-2t\\big(\\cos ak_x+\\cos ak_y+\\cos ak_z\\big),\\qquad W=12t",
      "label": "tight binding, script (3.62); bandwidth W"
     },
     {
      "kind": "eq",
      "tex": "\\varepsilon\\approx\\varepsilon-t_0-6t+ta^2k^2\\ \\ (k\\to0)\\quad\\Rightarrow\\quad m^*=\\frac{\\hbar^2}{2ta^2}",
      "label": "effective mass at the band bottom"
     },
     {
      "kind": "pitfall",
      "html": "Larger overlap means larger $t$: a wider band and a <i>smaller</i> effective mass. Near the band top ($k=\\pi/a$) the curvature is negative: $m^*=-\\hbar^2/2ta^2$."
     }
    ],
    "check": [
     {
      "q": "Bandwidth of the simple-cubic tight-binding band",
