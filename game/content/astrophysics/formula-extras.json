      "kind": "eq",
      "tex": "\\rho_c=\\frac{3H_0^2}{8\\pi G}\\approx9.2\\times10^{-27}\\,\\mathrm{kg\\,m^{-3}}\\,\\Big(\\frac{H_0}{70\\,\\mathrm{km/s/Mpc}}\\Big)^2,\\qquad \\frac1{H_0}\\approx14\\,\\mathrm{Gyr}",
      "label": "critical density and Hubble time in numbers"
     }
    ],
