    "title": "Formula cards: Schwarzschild radius and free-fall time",
    "source": [
     {
      "file": "materials/astrophysics/scripts/Choudhuri_Textbook.pdf",
      "where": "Choudhuri 5, 8.3, 13 (Schwarzschild)"
     }
    ],
    "blocks": [
     {
      "kind": "text",
      "html": "Two quick scales: the size of a black hole, and how long a pressureless cloud needs to collapse."
     },
     {
      "kind": "eq",
      "tex": "R_S=\\frac{2GM}{c^2}\\approx3\\,\\mathrm{km}\\,\\frac M{M_\\odot}",
      "label": "Schwarzschild radius"
     },
     {
      "kind": "eq",
      "tex": "t_{\\rm ff}=\\sqrt{\\frac{3\\pi}{32G\\rho}}\\approx\\frac{0.54}{\\sqrt{G\\rho}}",
      "label": "free-fall time of a uniform sphere"
     }
    ],
    "check": [
     {
      "q": "$R_S$ of a $10^8M_\\odot$ black hole",
      "options": [
       "$3\\times10^8$ km $\\approx2$ AU",
       "3 km",
       "$3\\times10^{12}$ km",
       "1 pc"
      ],
      "correct": 0,
      "explain": "$3\\,\\mathrm{km}\\times10^8$."
     },
     {
      "q": "The free-fall time depends on",
      "options": [
       "only the mean density",
       "the radius only",
       "the temperature",
       "the mass only"
      ],
      "correct": 0,
      "explain": "$t_{\\rm ff}\\propto1/\\sqrt{G\\rho}$."
     }
    ]
   }
