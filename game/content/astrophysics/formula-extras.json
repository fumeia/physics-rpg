    "title": "Formula card: Eddington luminosity",
    "source": [
     {
      "file": "materials/astrophysics/scripts/Choudhuri_Textbook.pdf",
      "where": "Choudhuri 3.6.1"
     }
    ],
    "blocks": [
     {
      "kind": "text",
      "html": "Radiation pressure on electrons (Thomson) balances gravity on the protons they drag along:"
     },
     {
      "kind": "eq",
      "tex": "L_{\\rm Edd}=\\frac{4\\pi GMm_pc}{\\sigma_T}\\approx1.3\\times10^{31}\\,\\mathrm W\\,\\frac{M}{M_\\odot}=3.3\\times10^4L_\\odot\\frac M{M_\\odot}",
      "label": "Eddington luminosity (pure hydrogen, Thomson opacity)"
     },
     {
      "kind": "eq",
      "tex": "\\dot M_{\\rm Edd}=\\frac{L_{\\rm Edd}}{\\eta c^2},\\qquad t_{\\rm Edd}=\\frac{M}{\\dot M_{\\rm Edd}}=\\frac{\\eta\\,\\sigma_Tc}{4\\pi Gm_p}\\approx\\eta\\times4.5\\times10^8\\,\\mathrm{yr}",
      "label": "Eddington accretion rate and growth time (HS25 winter Q6)"
     }
    ],
    "check": [
     {
      "q": "$L_{\\rm Edd}$ scales with mass as",
      "options": [
       "$\\propto M$",
       "$\\propto M^2$",
       "$\\propto M^3$",
       "independent of $M$"
      ],
      "correct": 0,
      "explain": "Gravity and radiation force both $\\propto1/r^2$."
     },
     {
      "q": "A black hole growing at the Eddington rate grows",
      "options": [
       "exponentially (e-folding time $\\propto\\eta$)",
       "linearly",
       "not at all",
       "as $t^2$"
      ],
      "correct": 0,
      "explain": "$\\dot M\\propto M$."
     }
    ]
   }
  },
