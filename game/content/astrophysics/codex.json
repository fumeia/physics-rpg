{
  "course": "astrophysics",
  "entries": [
    {
      "id": "pc",
      "group": "Distances and angles",
      "title": "Parallax and parsec",
      "tex": "d[\\mathrm{pc}]=1/p[''],\\ 1\\,\\mathrm{pc}=206265\\,\\mathrm{AU}=3.086\\times10^{16}\\,\\mathrm m",
      "meaning": "Distance from the yearly parallax angle.",
      "source": "Choudhuri §1.3"
    },
    {
      "id": "rayleigh",
      "group": "Distances and angles",
      "title": "Diffraction limit",
      "tex": "\\theta\\simeq1.22\\,\\lambda/D",
      "meaning": "Smallest resolvable angle of a circular aperture.",
      "when": "telescope resolution questions",
      "source": "HS25 practice Q1"
    },
    {
      "id": "mag",
      "group": "Photometry",
      "title": "Magnitudes",
      "tex": "m_1-m_2=-2.5\\log_{10}(F_1/F_2)",
      "meaning": "5 mag = factor 100; larger m = fainter.",
      "source": "Choudhuri §1.4"
    },
    {
      "id": "dmod",
      "group": "Photometry",
      "title": "Distance modulus",
      "tex": "m-M=5\\log_{10}(d/10\\,\\mathrm{pc})+A_\\lambda",
      "meaning": "M = magnitude at 10 pc; A = extinction in mag.",
      "source": "Choudhuri §1.4"
    },
    {
      "id": "ext",
      "group": "Photometry",
      "title": "Extinction as a flux ratio",
      "tex": "F_{\\rm ext}/F_0=10^{-A/2.5}",
      "meaning": "Dimming by dust.",
      "source": "HS24 summer Q4"
    },
    {
      "id": "planck",
      "group": "Radiation",
      "title": "Planck function",
      "tex": "B_\\nu=\\frac{2h\\nu^3}{c^2}\\frac{1}{e^{h\\nu/k_BT}-1}",
      "meaning": "Specific intensity of a blackbody.",
      "source": "Choudhuri (2.6)"
    },
    {
      "id": "dBdT",
      "group": "Radiation",
      "title": "Temperature derivative of Planck",
      "tex": "\\frac{\\partial B_\\nu}{\\partial T}=\\frac{2h\\nu^3}{c^2T}\\frac{xe^x}{(e^x-1)^2},\\ x=\\frac{h\\nu}{k_BT}",
      "meaning": "Converts intensity fluctuations to temperature fluctuations; always > 0.",
      "source": "HS24 summer Q2c"
    },
    {
      "id": "rj",
      "group": "Radiation",
      "title": "Rayleigh–Jeans limit",
      "tex": "B_\\nu\\simeq2k_BT\\nu^2/c^2\\quad(h\\nu\\ll k_BT)",
      "meaning": "Classical limit, linear in T. CMB: valid below 57 GHz.",
      "source": "HS24 summer Q2a"
    },
    {
      "id": "wien",
      "group": "Radiation",
      "title": "Wien displacement",
      "tex": "\\lambda_{\\max}T=2.898\\times10^{-3}\\,\\mathrm{m\\,K}",
      "meaning": "Peak wavelength of B_λ.",
      "source": "HS25 winter Q3"
    },
    {
      "id": "sb",
      "group": "Radiation",
      "title": "Stefan–Boltzmann",
      "tex": "u=a_BT^4,\\ F=\\sigma_{SB}T^4=\\tfrac{c}{4}a_BT^4,\\ L=4\\pi R^2\\sigma_{SB}T_{\\rm eff}^4",
      "meaning": "Energy density, emergent flux, stellar luminosity (defines T_eff).",
      "source": "Choudhuri §2.2"
    },
    {
      "id": "Lfd",
      "group": "Photometry",
      "title": "Flux from luminosity",
      "tex": "F=\\frac{L}{4\\pi d^2}",
      "meaning": "Inverse-square law (no extinction, no cosmology)."
    },
    {
      "id": "Inu",
      "group": "Radiative transfer",
      "title": "Moments of the intensity",
      "tex": "F_\\nu=\\oint I_\\nu\\cos\\theta\\,d\\Omega,\\ U_\\nu=\\tfrac1c\\oint I_\\nu d\\Omega,\\ P_\\nu=\\tfrac1c\\oint I_\\nu\\cos^2\\theta\\,d\\Omega",
      "meaning": "Isotropic: F = 0, P = U/3.",
      "source": "Choudhuri (2.3)-(2.9)"
    },
    {
      "id": "rte",
      "group": "Radiative transfer",
      "title": "Transfer equation and solution",
      "tex": "\\frac{dI_\\nu}{d\\tau_\\nu}=S_\\nu-I_\\nu,\\ I=I_0e^{-\\tau}+S(1-e^{-\\tau})",
      "meaning": "dτ = α ds, S = j/α. Thick: I → S; thin: I ≈ I0 + Sτ.",
      "source": "Choudhuri (2.12)-(2.19)"
    },
    {
      "id": "kirch",
      "group": "Radiative transfer",
      "title": "Kirchhoff (LTE)",
      "tex": "S_\\nu=j_\\nu/\\alpha_\\nu=B_\\nu(T)",
      "meaning": "Valid when the mean free path is much smaller than the scale of gradients; not for scattering.",
      "source": "Choudhuri (2.26)"
    },
    {
      "id": "grey",
      "group": "Radiative transfer",
      "title": "Grey atmosphere (Eddington)",
      "tex": "T^4=\\tfrac34T_{\\rm eff}^4(\\tau+\\tfrac23),\\ \\frac{I(0,\\mu)}{I(0,1)}=\\tfrac35(\\mu+\\tfrac23)",
      "meaning": "T = T_eff at τ = 2/3; limb at 40 % of centre.",
      "source": "Choudhuri (2.69)-(2.70)"
    },
    {
      "id": "opac",
      "group": "Radiative transfer",
      "title": "Opacities",
      "tex": "\\alpha=\\chi\\rho,\\ \\chi_T=\\sigma_T/m_H=0.04\\,\\mathrm{m^2/kg},\\ \\chi_{\\rm Kramers}\\propto\\rho T^{-3.5}",
      "meaning": "Thomson scattering (hot, ionised); bound-free/free-free (Kramers).",
      "source": "Choudhuri (2.79), (2.85)"
    },
    {
      "id": "raddiff",
      "group": "Stellar structure",
      "title": "Radiative temperature gradient",
      "tex": "\\frac{dT}{dr}=-\\frac{3\\chi\\rho}{4a_BcT^3}\\frac{L_r}{4\\pi r^2}",
      "meaning": "Energy transport by photon diffusion.",
      "source": "HS25 practice Q2c"
    },
    {
      "id": "schw",
      "group": "Stellar structure",
      "title": "Schwarzschild criterion",
      "tex": "\\left|\\tfrac{dT}{dr}\\right|<\\left(1-\\tfrac1\\gamma\\right)\\tfrac TP\\left|\\tfrac{dP}{dr}\\right|",
      "meaning": "Stable against convection when true.",
      "source": "HS25 practice MC4"
    },
    {
      "id": "rw",
      "group": "Radiative transfer",
      "title": "Random walk",
      "tex": "L=\\sqrt N\\,l,\\ t_{\\rm diff}\\sim R^2/(lc)",
      "meaning": "Photon diffusion time out of a star (~10⁴ yr for the Sun).",
      "source": "Choudhuri §2.8"
    },
    {
      "id": "hse",
      "group": "Stellar structure",
      "title": "Structure equations",
      "tex": "\\frac{dM_r}{dr}=4\\pi r^2\\rho,\\ \\frac{dP}{dr}=-\\frac{GM_r\\rho}{r^2},\\ \\frac{dL_r}{dr}=4\\pi r^2\\rho\\varepsilon",
      "meaning": "Mass continuity, hydrostatic equilibrium, energy generation; plus the radiative gradient.",
      "source": "Choudhuri (3.25)-(3.28)"
    },
    {
      "id": "eos",
      "group": "Stellar structure",
      "title": "Ideal gas",
      "tex": "P=\\frac{\\rho k_BT}{\\mu m_H},\\ \\mu=(2X+\\tfrac34Y+\\tfrac12Z)^{-1}",
      "meaning": "μ = 1/2 for ionised hydrogen.",
      "source": "Choudhuri (3.23)-(3.24)"
    },
    {
      "id": "virial",
      "group": "Stellar structure",
      "title": "Virial theorem",
      "tex": "2E_T+E_G=0,\\ E=\\tfrac12E_G",
      "meaning": "Stars heat up when they lose energy.",
      "source": "Choudhuri (3.10)-(3.12)"
    },
    {
      "id": "kh",
      "group": "Stellar structure",
      "title": "Kelvin–Helmholtz time",
      "tex": "\\tau_{KH}\\approx\\frac{GM^2}{2RL}\\approx10^7\\,\\mathrm{yr}\\ (\\odot)",
      "meaning": "Shining by contraction alone.",
      "source": "Choudhuri (3.13)"
    },
    {
      "id": "scal",
      "group": "Stellar structure",
      "title": "Main-sequence scalings",
      "tex": "P\\propto\\frac{M^2}{R^4},\\ T\\propto\\frac MR,\\ L\\propto M^3,\\ L\\propto T_{\\rm eff}^6,\\ \\tau\\propto M^{-2}",
      "meaning": "Homology-type estimates with constant opacity.",
      "source": "Choudhuri (3.33)-(3.41)"
    },
    {
      "id": "Ledd",
      "group": "Stellar structure",
      "title": "Eddington luminosity",
      "tex": "L_{Edd}=\\frac{4\\pi cGM}{\\chi}=\\frac{4\\pi GMm_pc}{\\sigma_T}\\approx3.3\\times10^4L_\\odot\\frac{M}{M_\\odot}",
      "meaning": "Radiation pressure balances gravity.",
      "source": "HS24 summer Q3"
    },
    {
      "id": "nuct",
      "group": "Stellar structure",
      "title": "Nuclear timescale",
      "tex": "\\tau_{\\rm nuc}\\approx\\frac{0.007\\cdot0.1\\,Mc^2}{L}\\approx10^{10}\\,\\mathrm{yr}\\ (\\odot)",
      "meaning": "0.7 % mass defect of H → He, 10 % of the mass burns."
    },
    {
      "id": "BE",
      "group": "Nuclear astrophysics",
      "title": "Binding energy",
      "tex": "E_B=[Zm_p+(A-Z)m_n-m_{\\rm nuc}]c^2",
      "meaning": "Peak of E_B/A ≈ 8.8 MeV at Fe; He-4: 7.1 MeV.",
      "source": "Choudhuri (4.1)"
    },
    {
      "id": "Hburn",
      "group": "Nuclear astrophysics",
      "title": "Hydrogen burning",
      "tex": "4\\,{}^1\\mathrm H\\to{}^4\\mathrm{He}+2e^++2\\nu_e+26.7\\,\\mathrm{MeV}",
      "meaning": "0.7 % of rest mass; pp chain (Sun) or CNO (M > 1.3 M_sun).",
      "source": "Choudhuri §4.3"
    },
    {
      "id": "gamow",
      "group": "Nuclear astrophysics",
      "title": "Gamow factor and peak",
      "tex": "P\\simeq e^{-\\sqrt{E_G/E}},\\ E_G=2mc^2(\\pi\\alpha Z_1Z_2)^2,\\ E_0=(\\tfrac12\\sqrt{E_G}k_BT)^{2/3}",
      "meaning": "Tunnelling through the Coulomb barrier; p+p: E_G = 493 keV, E_0 ≈ 6 keV.",
      "source": "Choudhuri (4.7)-(4.14)"
    },
    {
      "id": "Tsens",
      "group": "Nuclear astrophysics",
      "title": "Temperature sensitivity",
      "tex": "\\varepsilon_{pp}\\propto T^4,\\ \\varepsilon_{CNO}\\propto T^{16\\text{–}20}",
      "meaning": "(τ−2)/3 with τ = 3E_0/k_BT."
    },
    {
      "id": "transit",
      "group": "Nuclear astrophysics",
      "title": "Exoplanet signals",
      "tex": "\\frac{\\Delta F}{F}=\\left(\\frac{R_p}{R_\\star}\\right)^2,\\quad v_\\star=\\frac{m_p}{M_\\star}v_p",
      "meaning": "Transit depth and radial-velocity wobble.",
      "source": "Choudhuri §4.9"
    },
    {
      "id": "fermi",
      "group": "Compact objects",
      "title": "Fermi momentum",
      "tex": "n_e=\\frac{8\\pi p_F^3}{3h^3},\\ n_e=\\frac{\\rho}{\\mu_em_H},\\ \\mu_e=\\frac{2}{1+X}",
      "meaning": "Pauli filling of phase space; μe = 2 for He/C/O.",
      "source": "Choudhuri (5.2)-(5.8)"
    },
    {
      "id": "degP",
      "group": "Compact objects",
      "title": "Degeneracy pressure",
      "tex": "P=K_1\\rho^{5/3}\\ (\\text{non-rel.}),\\ P=K_2\\rho^{4/3}\\ (\\text{rel.})",
      "meaning": "K1 = 1.00e7/μe^{5/3}, K2 = 1.24e10/μe^{4/3} SI. Relativistic above ~2e9 kg/m³.",
      "source": "Choudhuri (5.9)-(5.12)"
    },
    {
      "id": "MR",
      "group": "Compact objects",
      "title": "White dwarf mass–radius and Chandrasekhar",
      "tex": "R\\propto M^{-1/3},\\ M_{Ch}=1.46\\,(2/\\mu_e)^2M_\\odot",
      "meaning": "More massive WDs are smaller; no WD above ~1.4 M_sun.",
      "source": "Choudhuri (5.25), (5.28)"
    },
    {
      "id": "breakup",
      "group": "Compact objects",
      "title": "Breakup period",
      "tex": "P_{\\min}=2\\pi\\sqrt{R^3/GM}",
      "meaning": "WD ~10 s, NS ~0.5 ms: only neutron stars can be ms pulsars."
    },
    {
      "id": "spindown",
      "group": "Compact objects",
      "title": "Pulsar spin-down",
      "tex": "L=4\\pi^2I\\dot P/P^3,\\ \\tau_c=P/(2\\dot P)",
      "meaning": "Rotational energy loss; characteristic age."
    },
    {
      "id": "acc",
      "group": "Compact objects",
      "title": "Accretion luminosity",
      "tex": "L=\\frac{GM\\dot M}{R}=\\eta\\dot Mc^2,\\ \\eta=\\frac{GM}{Rc^2}",
      "meaning": "NS: η ≈ 0.2; BH: η ≈ 0.1 (exam value).",
      "source": "Choudhuri §5.6, HS25 winter Q6"
    },
    {
      "id": "Aext",
      "group": "Interstellar medium",
      "title": "Extinction and reddening",
      "tex": "A_\\lambda=1.086\\,\\tau_\\lambda,\\ E(B-V)=A_B-A_V,\\ A_V\\approx3.1E(B-V)",
      "meaning": "Dust dims (adds magnitudes) and reddens.",
      "source": "Choudhuri §6.1"
    },
    {
      "id": "counts",
      "group": "Interstellar medium",
      "title": "Euclidean star counts",
      "tex": "N(F>F_0)\\propto F_0^{-3/2},\\ \\log N(<m)=0.6m+\\mathrm{const}",
      "meaning": "Uniform transparent distribution; deviations mean edges or extinction.",
      "source": "HS24 winter Q3"
    },
    {
      "id": "strom",
      "group": "Interstellar medium",
      "title": "Strömgren radius",
      "tex": "R_s=\\left(\\frac{3N_\\gamma}{4\\pi\\alpha n_pn_e}\\right)^{1/3}",
      "meaning": "Size of an HII region; ∝ n^{-2/3}.",
      "source": "HS25 practice Q4"
    },
    {
      "id": "21cm",
      "group": "Interstellar medium",
      "title": "21 cm line",
      "tex": "\\nu=1420.4\\,\\mathrm{MHz},\\ \\Delta E=5.9\\,\\mu\\mathrm{eV}",
      "meaning": "Hyperfine spin flip of neutral H; maps HI and Galactic rotation.",
      "source": "HS25 winter MC7"
    },
    {
      "id": "jeans",
      "group": "Interstellar medium",
      "title": "Jeans criterion",
      "tex": "\\omega^2=c_s^2(k^2-k_J^2),\\ k_J^2=\\frac{4\\pi G\\rho_0}{c_s^2},\\ M_J=\\frac43\\pi^{5/2}\\left(\\frac{k_BT}{Gm}\\right)^{3/2}\\rho_0^{-1/2}",
      "meaning": "λ > λ_J (M > M_J) collapses; smaller scales oscillate.",
      "source": "Choudhuri (8.20)-(8.23)"
    },
    {
      "id": "induct",
      "group": "Interstellar medium",
      "title": "Flux freezing",
      "tex": "R_M=VL/\\eta\\gg1\\Rightarrow B\\ \\text{moves with the plasma}",
      "meaning": "Collapse amplifies B ∝ R^{-2}.",
      "source": "Choudhuri (8.27), (8.31)"
    },
    {
      "id": "vc",
      "group": "Galaxies and dynamics",
      "title": "Circular velocity",
      "tex": "v_c^2=\\frac{GM_r}{r}",
      "meaning": "Flat curve: M ∝ r, ρ ∝ r^{-2}.",
      "source": "HS25 winter MC12"
    },
    {
      "id": "oort",
      "group": "Galaxies and dynamics",
      "title": "Oort constants",
      "tex": "v_R=Ad\\sin2l,\\ v_T=Ad\\cos2l+Bd,\\ v_c(R_0)=(A-B)R_0",
      "meaning": "A = 14.8, B = −12.4 km/s/kpc.",
      "source": "Choudhuri (6.19)-(6.24)"
    },
    {
      "id": "vesc",
      "group": "Galaxies and dynamics",
      "title": "Escape velocity, truncated flat halo",
      "tex": "v_{esc}^2=2v_c^2(1+\\ln(R/r))",
      "meaning": "Bound fastest star gives a lower limit on the halo size.",
      "source": "HS25 practice Q6"
    },
    {
      "id": "trel",
      "group": "Galaxies and dynamics",
      "title": "Relaxation time",
      "tex": "T_{\\rm rel}\\approx\\frac{v^3}{\\pi nG^2m^2}\\approx10^{10}\\,\\mathrm{yr}\\frac{v_{\\rm km/s}^3}{n_{\\rm pc^{-3}}},\\ \\frac{T_{\\rm rel}}{T_{\\rm cross}}\\approx N",
      "meaning": "Galaxies: 10^17 yr (collisionless).",
      "source": "Choudhuri (7.11)-(7.14)"
    },
    {
      "id": "cbe",
      "group": "Galaxies and dynamics",
      "title": "Collisionless Boltzmann",
      "tex": "\\partial_tf+\\mathbf v\\cdot\\nabla f-\\nabla\\Phi\\cdot\\partial_{\\mathbf v}f=0,\\ \\rho=m\\int f\\,d^3v",
      "meaning": "Jeans theorem: f(E, L) is a steady solution.",
      "source": "Choudhuri (7.25)"
    },
    {
      "id": "sis",
      "group": "Galaxies and dynamics",
      "title": "Singular isothermal sphere",
      "tex": "\\rho=\\frac{\\sigma^2}{2\\pi Gr^2},\\ v_c^2=2\\sigma^2",
      "meaning": "Flat rotation curve; ⟨v²⟩ independent of r.",
      "source": "HS25 practice MC12"
    },
    {
      "id": "plummer",
      "group": "Galaxies and dynamics",
      "title": "Plummer sphere",
      "tex": "\\Phi=-\\frac{GM}{\\sqrt{r^2+a^2}},\\ \\rho=\\frac{3M}{4\\pi a^3}\\left(1+\\frac{r^2}{a^2}\\right)^{-5/2}",
      "meaning": "From f ∝ (−E)^{7/2}.",
      "source": "HS25 winter Q4"
    },
    {
      "id": "tidal",
      "group": "Galaxies and dynamics",
      "title": "Tidal disruption",
      "tex": "a_{\\rm tid}\\simeq\\frac{2GMr}{d^3},\\ d_{\\rm lim}=\\left(\\frac{2M}{m}\\right)^{1/3}r",
      "meaning": "Satellite torn apart inside d_lim.",
      "source": "HS24 summer Q6"
    },
    {
      "id": "vir2",
      "group": "Galaxies and dynamics",
      "title": "Virial velocity dispersion",
      "tex": "\\sigma_v^2=\\frac{GM}{2r_H},\\ \\langle v^2\\rangle=\\frac{GM}{2\\langle R\\rangle}",
      "meaning": "Weighing clusters and galaxies.",
      "source": "HS24 summer Q5, HS25 practice Q5"
    },
    {
      "id": "fj",
      "group": "Galaxies and dynamics",
      "title": "Faber–Jackson and Tully–Fisher",
      "tex": "\\sigma\\approx220(L/L_*)^{1/4}\\,\\mathrm{km/s},\\ v_c\\approx220(L/L_*)^{0.22}\\,\\mathrm{km/s}",
      "meaning": "Velocity → luminosity → distance.",
      "source": "Choudhuri (9.4), (9.8)"
    },
    {
      "id": "devauc",
      "group": "Galaxies and dynamics",
      "title": "Surface-brightness profiles",
      "tex": "I=I_e\\exp\\{-7.67[(r/r_e)^{1/4}-1]\\},\\ I=I_0e^{-r/r_d}",
      "meaning": "Ellipticals (de Vaucouleurs) vs spiral disks.",
      "source": "Choudhuri (9.2)-(9.3)"
    },
    {
      "id": "synch",
      "group": "Radiation processes",
      "title": "Synchrotron",
      "tex": "\\nu\\sim\\gamma^2\\frac{eB}{2\\pi m_e},\\ N\\propto E^{-p}\\Rightarrow f\\propto\\nu^{-(p-1)/2}",
      "meaning": "Power law, polarised.",
      "source": "Choudhuri (8.69)"
    },
    {
      "id": "brems",
      "group": "Radiation processes",
      "title": "Thermal bremsstrahlung",
      "tex": "\\epsilon_\\nu\\propto n_en_iT^{-1/2}e^{-h\\nu/k_BT},\\ \\epsilon=1.4\\times10^{-40}\\sqrt Tn_en_iZ^2g",
      "meaning": "∝ n², cut-off at hν ~ kT.",
      "source": "Choudhuri (8.70)-(8.71)"
    },
    {
      "id": "Lx",
      "group": "Radiation processes",
      "title": "Cluster scaling",
      "tex": "L_X\\propto\\int\\rho_g^2T^{1/2}dV,\\ T\\propto M^{2/3},\\ L_X\\propto M^{4/3}",
      "meaning": "Virial + bremsstrahlung, M ∝ R³.",
      "source": "HS25 winter Q5"
    },
    {
      "id": "var",
      "group": "Radiation processes",
      "title": "Variability size limit",
      "tex": "R\\lesssim c\\Delta t,\\ M\\lesssim\\frac{Rc^2}{2G}",
      "meaning": "Upper limit on the size and black-hole mass.",
      "source": "HS24 winter Q6"
    },
    {
      "id": "superl",
      "group": "Radiation processes",
      "title": "Superluminal motion",
      "tex": "v_\\perp=\\frac{v\\sin\\theta}{1-\\beta\\cos\\theta},\\ v_{\\perp,\\max}=\\gamma v",
      "meaning": "Light-travel-time effect.",
      "source": "Choudhuri (9.21)"
    },
    {
      "id": "hubble",
      "group": "Cosmology",
      "title": "Hubble law and redshift",
      "tex": "v=H_0d,\\ 1+z=\\frac{a_0}{a}=\\frac{\\lambda_{\\rm obs}}{\\lambda_{\\rm em}},\\ \\frac{1}{H_0}=\\frac{977.8}{H_0[\\mathrm{km/s/Mpc}]}\\,\\mathrm{Gyr}",
      "meaning": "v ≈ cz only for z ≪ 1.",
      "source": "Choudhuri (10.22)-(10.24)"
    },
    {
      "id": "fried",
      "group": "Cosmology",
      "title": "Friedmann equation",
      "tex": "\\left(\\frac{\\dot a}{a}\\right)^2=\\frac{8\\pi G}{3}\\rho-\\frac{kc^2}{a^2}",
      "meaning": "Newtonian shell energy with 2E = −kc².",
      "source": "Choudhuri (10.27)"
    },
    {
      "id": "rhoc",
      "group": "Cosmology",
      "title": "Critical density, Ω, curvature",
      "tex": "\\rho_c=\\frac{3H^2}{8\\pi G}=1.88\\times10^{-26}h^2\\,\\mathrm{kg\\,m^{-3}},\\ \\frac{kc^2}{a^2H^2}=\\Omega-1",
      "meaning": "Ω > 1 closed, = 1 flat, < 1 open.",
      "source": "Choudhuri (10.29)-(10.31)"
    },
    {
      "id": "fluid",
      "group": "Cosmology",
      "title": "Equation of state",
      "tex": "P=w\\rho c^2\\Rightarrow\\rho\\propto a^{-3(1+w)}",
      "meaning": "Matter w = 0 (a^{-3}), radiation 1/3 (a^{-4}), Λ −1 (const).",
      "source": "Choudhuri (10.36)-(10.40)"
    },
    {
      "id": "sols",
      "group": "Cosmology",
      "title": "Flat solutions",
      "tex": "a\\propto t^{2/(3(1+w))},\\ \\text{matter }t^{2/3},\\ \\text{rad. }t^{1/2},\\ \\Lambda:\\ e^{Ht}",
      "meaning": "Age = α/H for a power law.",
      "source": "HS24 summer Q7, HS25 practice Q7"
    },
    {
      "id": "closed",
      "group": "Cosmology",
      "title": "Closed matter universe",
      "tex": "\\frac{a}{a_0}=\\frac{\\Omega_0(1-\\cos\\eta)}{2(\\Omega_0-1)},\\ H_0t=\\frac{\\Omega_0(\\eta-\\sin\\eta)}{2(\\Omega_0-1)^{3/2}}",
      "meaning": "Turnaround η = π, crunch η = 2π; lifetime πΩ/(H0(Ω−1)^{3/2}).",
      "source": "HS24 winter Q7"
    },
    {
      "id": "eq",
