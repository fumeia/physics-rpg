    "title": "Formula cards: Plummer sphere and tidal radius",
    "source": [
     {
      "file": "materials/astrophysics/scripts/Choudhuri_Textbook.pdf",
      "where": "Choudhuri 7; HS25 winter Q4 (Plummer), HS24 summer Q6 (tidal disruption)"
     }
    ],
    "blocks": [
     {
      "kind": "text",
      "html": "The Plummer sphere is the standard soft-core model of a star cluster; the tidal radius says where a companion&#8217;s pull wins."
     },
     {
      "kind": "eq",
      "tex": "\\Phi(r)=-\\frac{GM}{\\sqrt{r^2+b^2}},\\qquad \\rho(r)=\\frac{3M}{4\\pi b^3}\\left(1+\\frac{r^2}{b^2}\\right)^{-5/2}",
      "label": "Plummer potential and density"
     },
     {
      "kind": "eq",
      "tex": "r_t\\approx R\\left(\\frac{m}{3M}\\right)^{1/3}\\ \\ (\\text{satellite }m\\text{ at distance }R),\\qquad r_{\\rm TD}\\approx R_*\\left(\\frac{M_{\\rm BH}}{M_*}\\right)^{1/3}",
      "label": "tidal radius; tidal-disruption radius of a star"
     }
    ],
    "check": [
     {
      "q": "At $r\\gg b$ the Plummer potential becomes",
      "options": [
       "$-GM/r$ (point mass)",
       "constant",
       "harmonic",
       "$-GM/b$"
      ],
      "correct": 0,
      "explain": "Soft core only matters inside $b$."
     },
     {
      "q": "A star is torn apart by a black hole when it comes closer than about",
      "options": [
       "$R_*(M_{\\rm BH}/M_*)^{1/3}$",
       "$R_S$ always",
       "$R_*$",
       "1 pc"
      ],
      "correct": 0,
      "explain": "Tidal acceleration exceeds the star&#8217;s self-gravity."
     }
    ]
   }
