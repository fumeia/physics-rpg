#!/usr/bin/python3
"""Physics RPG for the Linux desktop (Zorin OS 17/18, Ubuntu 24.04): a window around the game on your own server (GTK 3 + WebKitGTK).

- The game and every update of it come from the server; progress is the same profile as in the browser and on the phone.
- Offline: the game's service worker keeps a copy of all files, so it starts and plays without a network; progress is saved
  on this computer and merged with the server (and your other devices) as soon as it is online again.
- The server's login (basic auth) is asked once and remembered (in ~/.config/physics-rpg/config.json, readable only by you).
  The window talks to a small relay on 127.0.0.1 that adds the login to every request to the server: WebKit's service worker
  does not reliably pass a basic-auth login on, which left the game stuck on its loading screen behind a login.
Keys: F11 full screen · Ctrl+R reload · Ctrl+, server settings · Ctrl+Q quit.
If the game does not finish loading within 30 s, a bar shows why, with fixes (reload, simple mode, software rendering, fresh
offline copy). The game's messages are logged to ~/.cache/physics-rpg/console.log.

  physics-rpg-desktop                 # normal start
  physics-rpg-desktop --settings      # change the server address or login
  physics-rpg-desktop --url URL       # open another address once (e.g. a local serve.py)
  physics-rpg-desktop --software      # software rendering (graphics driver trouble: blank or frozen window)
  physics-rpg-desktop --lite          # the simple menu without 3D
  physics-rpg-desktop --dev           # right click > Inspect element: the browser developer tools
"""
import argparse, base64, http.client, http.server, json, os, socket, ssl, sys, threading
from urllib.parse import urlparse
if '--software' in sys.argv:  # graphics driver trouble: let WebKit draw without the GPU path that breaks on some drivers
    os.environ.setdefault('WEBKIT_DISABLE_DMABUF_RENDERER', '1'); os.environ.setdefault('WEBKIT_DISABLE_COMPOSITING_MODE', '1'); os.environ.setdefault('LIBGL_ALWAYS_SOFTWARE', '1')
import gi
gi.require_version('Gtk', '3.0'); gi.require_version('WebKit2', '4.1')
from gi.repository import Gtk, Gdk, Gio, GLib, WebKit2  # noqa: E402

APP = 'physics-rpg'
CONF_DIR = os.path.join(GLib.get_user_config_dir(), APP); CONF = os.path.join(CONF_DIR, 'config.json')
DATA = os.path.join(GLib.get_user_data_dir(), APP, 'web'); CACHE = os.path.join(GLib.get_user_cache_dir(), APP)
LOG = os.path.join(CACHE, 'console.log')
ERRS = """window.__errs=[];addEventListener('error',function(e){__errs.push(String(e.message||e)+(e.filename?' @'+e.filename.split('/').pop()+':'+e.lineno:''))},true);addEventListener('unhandledrejection',function(e){__errs.push('promise: '+String(e.reason&&e.reason.message||e.reason))});"""
ICON = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'icon.png')


SOFTWARE = '--software' in sys.argv


def restart(extra):
    args = [a for a in sys.argv[1:] if a not in extra] + extra
    os.execv(sys.executable, [sys.executable, os.path.realpath(__file__)] + args)


def load_conf():
    try:
        with open(CONF) as f: return json.load(f)
    except Exception: return {}


def save_conf(c):
    os.makedirs(CONF_DIR, exist_ok=True)
    fd = os.open(CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f: json.dump(c, f, indent=1)


def ask(parent, title, fields, text=None):
    """A small form: fields = [(key, label, value, secret)] -> dict or None."""
    d = Gtk.Dialog(title=title, transient_for=parent, modal=True); d.add_buttons('Cancel', Gtk.ResponseType.CANCEL, 'OK', Gtk.ResponseType.OK)
    d.set_default_response(Gtk.ResponseType.OK); box = d.get_content_area(); box.set_spacing(6); box.set_border_width(14)
    if text: lab = Gtk.Label(label=text, xalign=0); lab.set_line_wrap(True); lab.set_max_width_chars(60); box.add(lab)
    ents = {}
    for key, label, value, secret in fields:
        box.add(Gtk.Label(label=label, xalign=0)); e = Gtk.Entry(text=value or ''); e.set_visibility(not secret); e.set_activates_default(True); e.set_width_chars(46); box.add(e); ents[key] = e
    d.show_all(); r = d.run(); out = {k: e.get_text().strip() if k != 'password' else e.get_text() for k, e in ents.items()} if r == Gtk.ResponseType.OK else None
    d.destroy(); return out


def settings_dialog(parent, conf):
    r = ask(parent, 'Physics RPG: your server', [('url', 'Game address (your server)', conf.get('url') or 'https://', False),
            ('user', 'Login name (empty if the server has none)', conf.get('user', ''), False), ('password', 'Password', conf.get('password', ''), True)],
            'The address you open the game with in the browser, and the login of the server if it asks for one.')
    if not r: return None
    u = r['url']
    if not u.startswith(('http://', 'https://')): u = 'https://' + u
    if not u.endswith('/') and urlparse(u).path in ('', '/'): u += '/'
    conf.update(url=u, user=r['user'], password=r['password']); save_conf(conf); return conf


class Relay:
    """http://127.0.0.1:<port>/... -> the server, with the login added. Offline: answers 502 at once (the game then uses its copy)."""
    HOP = {'connection', 'keep-alive', 'proxy-authenticate', 'proxy-authorization', 'te', 'trailers', 'transfer-encoding', 'upgrade', 'host', 'content-length'}

    def __init__(self, upstream, user, password, port, on_refused):
        u = urlparse(upstream); self.https, self.netloc = u.scheme == 'https', u.netloc
        self.set_login(user, password); self.on_refused = on_refused; self.local = threading.local()
        relay = self

        class H(http.server.BaseHTTPRequestHandler):
            protocol_version = 'HTTP/1.1'
            def log_message(self, *a): pass
            def go(self): relay.forward(self)
            do_GET = do_HEAD = do_PUT = do_POST = do_DELETE = do_OPTIONS = go

        last = None
        for p in [port, 0]:  # the saved port keeps the same origin (and so the same offline copy and local progress)
            try: self.srv = http.server.ThreadingHTTPServer(('127.0.0.1', p), H); break
            except OSError as e: last = e
        else: raise last
        self.srv.daemon_threads = True; self.port = self.srv.server_address[1]
        threading.Thread(target=self.srv.serve_forever, daemon=True).start()

    def set_login(self, user, password):
        self.auth = 'Basic ' + base64.b64encode(f'{user}:{password}'.encode()).decode() if user else None

    def conn(self, fresh=False):
        c = getattr(self.local, 'c', None)
        if fresh and c: c.close(); c = None
        if not c:
            c = http.client.HTTPSConnection(self.netloc, timeout=10, context=ssl.create_default_context()) if self.https else http.client.HTTPConnection(self.netloc, timeout=10)
            self.local.c = c
        return c

    def forward(self, h):
        n = int(h.headers.get('Content-Length') or 0); body = h.rfile.read(n) if n else None
        hdrs = {k: v for k, v in h.headers.items() if k.lower() not in self.HOP and k.lower() not in ('authorization', 'origin', 'referer')}
        hdrs['Host'] = self.netloc
        if self.auth: hdrs['Authorization'] = self.auth
        r = None
        for attempt in (0, 1):  # a kept-alive connection the server closed: once more on a fresh one
            try:
                c = self.conn(fresh=attempt == 1); c.request(h.command, h.path, body=body, headers=hdrs); r = c.getresponse(); data = r.read(); break
            except (OSError, http.client.HTTPException):
                r = None
        if r is None:  # offline or server down
            msg = b'{"error": "offline"}'; h.send_response(502); h.send_header('Content-Type', 'application/json'); h.send_header('Content-Length', str(len(msg))); h.send_header('Cache-Control', 'no-store'); h.end_headers()
            if h.command != 'HEAD': h.wfile.write(msg)
            return
        if r.status == 401 and self.on_refused: GLib.idle_add(self.on_refused)
        h.send_response(r.status)
        for k, v in r.getheaders():
            if k.lower() not in self.HOP and k.lower() not in ('www-authenticate', 'strict-transport-security', 'alt-svc'):
                h.send_header(k, v)
        h.send_header('Content-Length', str(len(data))); h.end_headers()
        if h.command != 'HEAD': h.wfile.write(data)


class Game:
    def __init__(self, url, conf, test=False):
        self.conf, self.test, self.retry = conf, test, 0
        u = urlparse(url)
        self.relay = Relay(f'{u.scheme}://{u.netloc}', conf.get('user', ''), conf.get('password', ''), int(conf.get('port') or 47123), self.login_refused)
        if conf.get('port') != self.relay.port and not test: conf['port'] = self.relay.port; save_conf(conf)
        url = f'http://127.0.0.1:{self.relay.port}{u.path or "/"}' + (f'?{u.query}' if u.query else '')
        self.url = url
        dm = WebKit2.WebsiteDataManager(base_data_directory=DATA, base_cache_directory=CACHE)  # localStorage, service worker copy, cookies
        self.ctx = WebKit2.WebContext.new_with_website_data_manager(dm)
        dm.get_cookie_manager().set_persistent_storage(os.path.join(DATA, 'cookies.sqlite'), WebKit2.CookiePersistentStorage.SQLITE)
        self.ctx.connect('download-started', self.on_download)
        self.ucm = WebKit2.UserContentManager()  # catches the page's errors from the first line, for the loading check
        self.ucm.add_script(WebKit2.UserScript(ERRS, WebKit2.UserContentInjectedFrames.TOP_FRAME, WebKit2.UserScriptInjectionTime.START, None, None))
        self.dm = dm
        self.view = self.make_view(None)
        s = self.view.get_settings()
        s.set_property('user-agent', s.get_property('user-agent') + ' PhysicsRPG-Desktop/1.0')
        self.win = self.window(self.view, 'Physics RPG')
        self.win.connect('destroy', lambda *_: Gtk.main_quit())
        self.win.connect('focus-in-event', lambda *_: self.kick())  # coming back to the window: pull progress from the other devices
        self.win.connect('delete-event', self.on_close)
        self.view.load_uri(url); self.watch()

    def make_view(self, related):
        v = WebKit2.WebView.new_with_related_view(related) if related else WebKit2.WebView(web_context=self.ctx, user_content_manager=self.ucm)
        s = v.get_settings()
        for k, val in (('enable-webgl', True), ('enable-javascript', True), ('enable-html5-local-storage', True), ('enable-html5-database', True),
                       ('javascript-can-open-windows-automatically', True), ('enable-developer-extras', '--dev' in sys.argv), ('enable-back-forward-navigation-gestures', False)):
            try: s.set_property(k, val)
            except TypeError: pass
        if not SOFTWARE:
            try: s.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)
            except Exception: pass
        s.set_property('enable-write-console-messages-to-stdout', True)  # into console.log (see main)
        v.connect('authenticate', self.on_auth)
        v.connect('decide-policy', self.on_policy)
        v.connect('create', self.on_create)
        v.connect('load-failed', self.on_failed)
        v.connect('notify::title', lambda w, _p: w.get_toplevel().set_title(w.get_title() or 'Physics RPG') if isinstance(w.get_toplevel(), Gtk.Window) else None)
        return v

    def window(self, view, title):
        w = Gtk.Window(title=title); w.set_default_size(1280, 800)
        if os.path.exists(ICON): w.set_icon_from_file(ICON)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL); view.set_vexpand(True); box.pack_end(view, True, True, 0); w.add(box); w.box = box
        w.connect('key-press-event', self.on_key); w.show_all(); return w

    # ---- loading check: if the start screen has not finished after 30 s, say why and offer the usual fixes
    def watch(self):
        if getattr(self, 'watch_id', None): GLib.source_remove(self.watch_id)
        self.watch_id = GLib.timeout_add_seconds(30, self.check)

    def check(self):
        self.watch_id = None
        js = "JSON.stringify({ready: !!(document.getElementById('st-bar') && document.getElementById('st-bar').classList.contains('done')) || !document.getElementById('start') || document.getElementById('start').style.display === 'none', status: (document.getElementById('st-status')||{}).textContent || '', errs: [...(window.__errs||[]).slice(-4), ...[...document.querySelectorAll('body > pre')].map(function(x){return x.textContent.split('\\n')[0]})], webgl: !!document.createElement('canvas').getContext('webgl2'), sw: !!(navigator.serviceWorker && navigator.serviceWorker.controller)})"
        def done(v, res):
            try: info = json.loads(v.evaluate_javascript_finish(res).to_string())
            except Exception as e: info = {'ready': False, 'status': '', 'errs': [f'the page did not answer ({e})'], 'webgl': None, 'sw': None}
            print('LOADCHECK', json.dumps(info), flush=True)
            if not info.get('ready'): self.show_trouble(info)
        self.view.evaluate_javascript(js, -1, None, None, None, done)
        return False

    def show_trouble(self, info):
        if getattr(self, 'bar', None): self.bar.destroy()
        bar = Gtk.InfoBar(message_type=Gtk.MessageType.WARNING); self.bar = bar
        why = '; '.join(info.get('errs') or []) or ('no WebGL (3D graphics) in this window' if info.get('webgl') is False else f"stuck at \u201c{info.get('status') or 'Loading...'}\u201d")
        lab = Gtk.Label(xalign=0); lab.set_line_wrap(True); lab.set_selectable(True)
        lab.set_markup(f"<b>The game has not finished loading.</b> {GLib.markup_escape_text(why[:400])}\nDetails: {GLib.markup_escape_text(LOG)}")
        bar.get_content_area().add(lab)
        for i, t in enumerate(('Reload', 'Simple mode (no 3D)', 'Software rendering', 'Fresh offline copy', 'Close')): bar.add_button(t, i)
        bar.connect('response', self.on_trouble); self.win.box.pack_start(bar, False, False, 0); bar.show_all()

    def on_trouble(self, bar, r):
        bar.destroy(); self.bar = None
        if r == 0: self.view.reload(); self.watch()
        elif r == 1: self.view.load_uri(self.url + ('&' if '?' in self.url else '?') + 'lite=1'); self.watch()
        elif r == 2: restart(['--software'])
        elif r == 3:  # drops only the cached game files and the service worker; progress (localStorage) stays
            T = WebKit2.WebsiteDataTypes
            self.dm.clear(T.SERVICE_WORKER_REGISTRATIONS | T.DISK_CACHE | T.MEMORY_CACHE | T.DOM_CACHE, 0, None, lambda *_: (self.view.load_uri(self.url), self.watch()))

    def kick(self, *_):
        self.view.evaluate_javascript("try{window.dispatchEvent(new Event('online'))}catch(e){}", -1, None, None, None, None, None)
        return False

    def on_close(self, *_):  # one last sync, then close
        self.kick(); GLib.timeout_add(900, Gtk.main_quit); self.win.hide(); return True

    def on_key(self, w, ev):
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK; k = Gdk.keyval_name(ev.keyval)
        if k == 'F11':
            if w.get_window().get_state() & Gdk.WindowState.FULLSCREEN: w.unfullscreen()
            else: w.fullscreen()
            return True
        if ctrl and k in ('r', 'R'): self.view.reload(); self.watch(); return True
        if ctrl and k in ('q', 'Q'): self.on_close(); return True
        if ctrl and k == 'comma':
            c = settings_dialog(self.win, dict(self.conf))
            if c: self.conf = c; restart([])
            return True
        return False

    def login_refused(self):  # the server said 401 to the relay: the saved login is wrong or missing
        if getattr(self, 'asking', False): return False
        self.asking = True
        r = ask(self.win, 'Login', [('user', 'Login name', self.conf.get('user', ''), False), ('password', 'Password', '', True)], 'The server refused the saved login. Enter it again (the one you use in the browser).')
        self.asking = False
        if r: self.conf.update(user=r['user'], password=r['password']); save_conf(self.conf); self.relay.set_login(r['user'], r['password']); self.view.reload(); self.watch()
        return False

    def on_auth(self, view, req):
        user, pw = self.conf.get('user', ''), self.conf.get('password', '')
        if not user or req.is_retry():
            r = ask(self.win, 'Login', [('user', 'Login name', user, False), ('password', 'Password', '', True)], f'{req.get_host()} asks for its login.')
            if not r: req.cancel(); return True
            user, pw = r['user'], r['password']; self.conf.update(user=user, password=pw); save_conf(self.conf)
        req.authenticate(WebKit2.Credential.new(user, pw, WebKit2.CredentialPersistence.FOR_SESSION)); return True

    def same_site(self, uri):
        return urlparse(uri).netloc == urlparse(self.url).netloc

    def on_policy(self, view, decision, kind):
        if kind == WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            uri = decision.get_navigation_action().get_request().get_uri()
            if uri.startswith(('http://', 'https://')) and not self.same_site(uri):
                Gio.AppInfo.launch_default_for_uri(uri, None); decision.ignore(); return True
        return False

    def on_create(self, view, action):  # links that open a new tab (the chapter 7 pack, sheets): a second window, or the browser if elsewhere
        uri = action.get_request().get_uri()
        if uri and uri.startswith(('http://', 'https://')) and not self.same_site(uri):
            Gio.AppInfo.launch_default_for_uri(uri, None); return None
        v = self.make_view(view); w = self.window(v, 'Physics RPG'); v.connect('close', lambda *_: w.destroy()); return v

    def on_download(self, ctx, dl):  # the profile export and other downloads land in ~/Downloads
        folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOWNLOAD) or os.path.expanduser('~')
        dl.connect('decide-destination', lambda d, name: (d.set_destination('file://' + os.path.join(folder, name or 'physics-rpg-download')), True)[1])

    def on_failed(self, view, event, uri, err):
        # only reached when there is no offline copy yet (the first start needs the network once)
        if err.matches(WebKit2.NetworkError.quark(), WebKit2.NetworkError.CANCELLED) or self.test: return False
        view.load_alternate_html(f"""<html><body style="background:#070a12;color:#dde;font:16px sans-serif;padding:32px"><h2>Physics RPG</h2>
          <p>Could not reach <b>{self.url}</b> ({GLib.markup_escape_text(err.message)}).</p><p>The first start needs the internet once; after that the game also works offline.</p>
          <p><a style="color:#9cc0ff" href="{self.url}">Try again</a> &middot; wrong address? Ctrl+, opens the server settings.</p></body></html>""", self.url, None)
        return True


def main():
    ap = argparse.ArgumentParser(description='Physics RPG desktop app'); ap.add_argument('--settings', action='store_true'); ap.add_argument('--url'); ap.add_argument('--dev', action='store_true')
    ap.add_argument('--software', action='store_true'); ap.add_argument('--lite', action='store_true')
    ap.add_argument('--test', type=int, default=0, help='(for tests) print what loaded after N seconds, then quit')
    a = ap.parse_args()
    os.makedirs(CACHE, exist_ok=True)
    if not sys.stdout.isatty() and not a.test:  # started from the menu: keep the game's messages in a log file (last run only)
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600); os.dup2(fd, 1); os.dup2(fd, 2)
    GLib.set_prgname(APP); GLib.set_application_name('Physics RPG')
    conf = load_conf()
    if a.settings or (not a.url and not conf.get('url')):
        conf = settings_dialog(None, conf)
        if not conf: return 1
    url = a.url or conf['url']
    if a.lite: url += ('&' if '?' in url else '?') + 'lite=1'
    g = Game(url, conf, test=bool(a.test))
    if a.test:
        def report():
            js = "JSON.stringify({game: !!window.__game, courses: window.__game ? window.__game.catalog().length : 0, sw: !!(navigator.serviceWorker && navigator.serviceWorker.controller), sync: window.__game ? window.__game.syncState().status : null, webgl: !!document.createElement('canvas').getContext('webgl2')})"
            def done(v, res):
                try: print('REPORT', v.evaluate_javascript_finish(res).to_string(), flush=True)
                except Exception as e: print('REPORT-ERROR', e, flush=True)
                Gtk.main_quit()
            g.view.evaluate_javascript(js, -1, None, None, None, done); return False
        GLib.timeout_add_seconds(a.test, report)
    Gtk.main(); return 0


if __name__ == '__main__':
    sys.exit(main())
