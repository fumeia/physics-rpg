    ],
    "blocks": [
     {
      "kind": "text",
      "html": "Two formulas for the summary that the lessons only use in words: Einstein&#8217;s heat capacity and the Debye cutoff from counting modes."
     },
     {
      "kind": "eq",
      "tex": "C_V=\\frac{3Nk_B}{V}\\left(\\frac{\\hbar\\omega}{k_BT}\\right)^2\\frac{e^{\\hbar\\omega/k_BT}}{\\left(e^{\\hbar\\omega/k_BT}-1\\right)^2}",
      "label": "Einstein heat capacity, script (2.13), per volume"
     },
     {
      "kind": "eq",
      "tex": "k_D=\\left(6\\pi^2\\frac NV\\right)^{1/3},\\qquad \\omega_D=v_sk_D,\\qquad T_D=\\frac{\\hbar\\omega_D}{k_B}",
      "label": "Debye wave vector, frequency and temperature (one atom per cell, one sound velocity)"
     },
     {
      "kind": "intuition",
      "html": "$k_D$ is the radius of a sphere with as many $q$-points as atoms: $\\frac{V}{(2\\pi)^3}\\frac43\\pi k_D^3=N$. With three branches that gives the $3N$ modes."
     }
    ],
    "check": [
     {
      "q": "Einstein $C_V$ for $k_BT\\ll\\hbar\\omega$ decays as",
      "options": [
       "$e^{-\\hbar\\omega/k_BT}$ (times a power)",
       "$T^3$",
       "$T$",
       "constant"
      ],
      "correct": 0,
      "explain": "All modes are gapped."
     },
     {
      "q": "$k_D=(6\\pi^2N/V)^{1/3}$ follows from",
      "options": [
       "one $q$-point per atom inside the Debye sphere",
       "the Fermi sphere with spin",
       "the Brillouin zone volume times 2",
       "the sound velocity"
      ],
      "correct": 0,
      "explain": "$\\frac{V}{(2\\pi)^3}\\frac43\\pi k_D^3=N$."
     }
    ]
   }
